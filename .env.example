# Docker reverse proxy target for the already running Viewer backend.
PUBLIC_DOMAIN=angio.su
BACKEND_URL=https://angio.su/api

# Runtime reverse proxy target and Basic authorization for Orthanc DICOMweb.
PACS_URL=https://angio.su
PACS_AUTHORIZATION=Basic bWFwZHI6Y2hhbmdlc3Ryb25ncGFzc3dvcmQ=

# Local port for the frontend.
FRONTEND_PORT=5173

# Published Docker Hub image and OCI metadata.
FRONTEND_IMAGE=ghcr.io/repomz/viewer_frontend:0.2.36
IMAGE_VERSION=0.1.0
VCS_REF=unknown
