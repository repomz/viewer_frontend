{
  "name": "@repomz/viewer-frontend",
  "version": "0.2.22",
  "private": true,
  "description": "Adaptive clinical frontend for the Viewer DICOM platform",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build": "expo export --platform web && node scripts/postprocess-web.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.33",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "fflate": "^0.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.9.0"
}
