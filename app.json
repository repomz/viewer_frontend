{
  "expo": {
    "name": "Viewer Clinical",
    "slug": "viewer-clinical",
    "version": "0.2.19",
    "orientation": "portrait",
    "icon": "./assets/viewer-vessels-icon-v4.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F6F8",
    "primaryColor": "#0B84B3",
    "splash": {
      "image": "./assets/angiography-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#07131F"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/angiography-splash.png",
          "imageWidth": 430,
          "resizeMode": "cover",
          "backgroundColor": "#07131F"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/viewer-vessels-icon-v4.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/viewer-vessels-icon-v4.png",
        "backgroundColor": "#07131F"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Viewer Clinical",
      "shortName": "Viewer",
      "themeColor": "#07131F",
      "backgroundColor": "#07131F",
      "display": "standalone",
      "favicon": "./assets/favicon-xa-v4.png"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
